{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mogenius/renovate-config//presets/golang.json#main"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^docs/.+\\.md$/"],
      "matchStrings": ["image: (?<depName>renovate/renovate):(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/", "/^Dockerfile$/"],
      "matchStrings": ["unpkg\\.com/(?<depName>[^@\"]+)@(?<currentValue>[^/\"]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/", "/^Dockerfile$/"],
      "matchStrings": ["\"(?<depName>react|react-dom)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "The otel v0.x modules (log, sdk/log, otlploggrpc, contrib bridges) share an unstable API and only compile in lockstep, so core and contrib must land in a single PR regardless of update type.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["go.opentelemetry.io/**"],
      "groupName": "opentelemetry",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "matchPackageNames": ["registry.k8s.io/kubectl", "valkey"],
      "semanticCommitType": "fix"
    },
    {
      "description": "The ui-test.yaml container image bakes in browsers for a specific playwright-core release; @playwright/test in tests/ui/package.json must match it exactly or the browser tests hang/fail in CI, so bump both together.",
      "matchPackageNames": ["mcr.microsoft.com/playwright", "@playwright/test"],
      "groupName": "playwright"
    },
    {
      "matchDatasources": ["npm"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Update renovate/renovate image references in docs on Sunday nights only.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["renovate/renovate"],
      "schedule": ["after 10pm on Sunday"],
      "semanticCommitType": "chore"
    }
  ]
}
